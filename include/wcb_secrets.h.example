// wcb_secrets.h.example — copy to wcb_secrets.h (gitignored, see .gitignore)
// and fill in the real values for this robot's WCB ESP-NOW mesh.
//
// wcb_secrets.h is intentionally not committed: wcbpassword is a live shared
// secret for command access to a robot with powered servos, not a
// placeholder default like OTA_AP_PASSWORD in config.h.
#pragma once

#define WCB_MESH_OCT2      0x00  // 2nd octet of the shared WCB MAC scheme
#define WCB_MESH_OCT3      0x00  // 3rd octet of the shared WCB MAC scheme
#define WCB_MESH_PASSWORD  ""    // mesh password, max 39 chars
#define WCB_MESH_QUANTITY  0     // total physical WCBs in the mesh
#define WCB_MESH_DEVICE_ID 0     // this board's own WCB_Client device id (1-19)
